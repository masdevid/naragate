# Naragate Configuration
# Copy this file to .env and fill in your values.
#
# NOTE: For most users, the easiest path is to leave these empty and set
# everything through the web UI at /settings after starting the app.
# Keys set in the web UI take precedence over values in this file.

# Optional: Sectors v2 API key (get one at https://sectors.app)
# Leave empty to set it later via the web UI.
SECTORS_API_KEY=

# Optional: Sectors account email/password. Only used by the Playwright login
# flow (references/ or scripts) for first-party endpoints such as
# https://api.sectors.app/api/usage/ that require an OAuth bearer token.
# These are account credentials, not the API key — keep them out of git.
SECTORS_ACCOUNT_EMAIL=
SECTORS_ACCOUNT_PASSWORD=

# Optional: Sectors first-party OAuth (for the account endpoint /api/usage/,
# NOT the data API). Capture once from a logged-in browser — see
# references/sectors-account-usage.md. Leave empty unless you need credit usage.
SECTORS_OAUTH_CLIENT_ID=
SECTORS_OAUTH_CLIENT_SECRET=
SECTORS_OAUTH_REFRESH_TOKEN=
# Optional short-lived bearer token (used directly when present and unexpired).
SECTORS_OAUTH_ACCESS_TOKEN=

# LLM Provider Configuration (OpenAI-compatible endpoint)
# Default: local Ollama at http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Optional: default model. Leave empty to pick a model via the web UI
# (the settings page lists the models available on your endpoint).
OLLAMA_MODEL=

# Per-agent model overrides (optional, defaults to OLLAMA_MODEL)
# CLAIM_PARSER_MODEL=
# SKEPTIC_MODEL=
# SCORER_MODEL=

# Ports
FRONTEND_PORT=4273
BACKEND_PORT=5678

# Redis (evidence cache only)
REDIS_URL=redis://localhost:6379

# Pi Agent
PI_AGENT_URL=http://localhost:3000

# Pi Agent LLM gateway API key. Own var on purpose: if you also export
# OLLAMA_API_KEY in the shell, compose interpolation would shadow .env and
# pi-agent would silently use the wrong key. Keep PI_AGENT_API_KEY unset in
# the shell so the value below (from .env) is what compose picks up.
PI_AGENT_API_KEY=
