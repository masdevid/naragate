# Naragate Configuration
# Copy this file to .env and fill in your values

# Required: Sectors v2 API key
SECTORS_API_KEY=your_api_key_here

# LLM Provider Configuration (OpenAI-compatible endpoint)
# Default: local Ollama. Can be OpenRouter, Together, Groq, etc.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# Per-agent model overrides (optional, defaults to OLLAMA_MODEL)
# CLAIM_PARSER_MODEL=qwen3-coder:30b
# SKEPTIC_MODEL=qwen2.5:7b
# SCORER_MODEL=llama3.2:1b

# Ports
FRONTEND_PORT=4273
BACKEND_PORT=5678

# Redis (evidence cache only)
REDIS_URL=redis://localhost:6379

# Pi Agent
PI_AGENT_URL=http://localhost:3000
